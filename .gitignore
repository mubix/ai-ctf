*.bak
*.swp
*~

# ---------------------------------------------------------------------------
# external_artifacts/anvil_chatkit/.git
# ---------------------------------------------------------------------------
# The chatkit subdirectory has (or will get) its OWN git history — that
# history is the artifact that carries flag #15. It must NOT be a nested
# repo inside ai-ctf's git tree. Keep it locally if you want to push
# directly from this checkout, otherwise it's fine to delete.
external_artifacts/anvil_chatkit/.git/
